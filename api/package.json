{
  "name": "max-dispatcher-api",
  "version": "0.1.0",
  "private": true,
  "description": "Бизнес-логика диспетчера обращений",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
