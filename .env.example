# ─────────────────────────────────────────────────────────────
# Шаблон окружения. Скопируй в .env и подставь реальные значения.
#   cp .env.example .env
#
# .env закоммичен быть НЕ МОЖЕТ (см. .gitignore + .githooks/pre-commit).
# В этом файле — ТОЛЬКО плейсхолдеры, никаких настоящих секретов.
# ─────────────────────────────────────────────────────────────

# ── bot ──────────────────────────────────────────────────────
# Токен бота из @MasterBot в MAX. Формат: длинная base64url-строка.
MAX_BOT_TOKEN=paste-your-max-bot-token-here

# База MAX Bot API. С 19.07.2026 — platform-api2 (старый platform-api устарел).
MAX_API_BASE_URL=https://platform-api2.max.ru

# Таймаут long polling в секундах, допустимый диапазон 0..90.
MAX_POLL_TIMEOUT=90

# Бот работает через long polling и НЕ слушает порт —
# публичный HTTPS-эндпоинт для MVP не нужен.

# platform-api2.max.ru подписан сертификатом Russian Trusted CA (Минцифры РФ).
# Windows/браузер ему доверяют, а встроенный список CA у Node.js — нет:
# без этой строки запрос падает с "unable to get local issuer certificate".
# Путь относительный — резолвится и локально (cwd=bot/), и в Docker (cwd=/app).
# Сам сертификат — bot/certs/russian-trusted-ca-chain.pem, см. bot/certs/README.md.
NODE_EXTRA_CA_CERTS=certs/russian-trusted-ca-chain.pem

# Адрес внутреннего api, куда бот ходит за жителем.
# В docker-compose переопределяется на http://api:3000 (имя сервиса в сети
# compose) — это значение используется только при локальном запуске без Docker.
API_BASE_URL=http://localhost:3000

# Таймаут запроса бота к api, мс. Короткий: человек ждёт ответа в чате.
API_TIMEOUT_MS=5000

# ── api ──────────────────────────────────────────────────────
API_PORT=3000

# ── db ───────────────────────────────────────────────────────
POSTGRES_USER=max
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=max_dispatcher

# Порт, на котором Postgres виден с хоста (внутри compose всегда 5432).
DB_PORT=5432

# Хост `db` — это имя сервиса в docker-compose.
# Для запуска без Docker замени db -> localhost.
DATABASE_URL=postgres://max:change-me-locally@db:5432/max_dispatcher

# ── тестовые данные (только для npm run seed) ────────────────
# Номера тестовых жителей через запятую, в любом виде: +7XXXXXXXXXX,
# 8 XXX XXX-XX-XX, XXXXXXXXXX. Это персональные данные — только в .env.
# Пусто — жители не создаются.
SEED_TEST_PHONES=
# Ссылка на тестовый чат для первого дома, https://… Пусто — чата нет.
SEED_HOUSE_CHAT_LINK=

# ── деплой (используется только docker compose --profile deploy) ──────
# Куда сервис miniapp-build кладёт собранную статику. Оттуда её раздаёт
# системный nginx — см. docs/RUN.md, раздел «Деплой на VPS».
# Для локальной разработки не нужен: сервис не запускается сам по себе.
MINIAPP_DIST_DIR=/var/www/magistralbot

# ВРЕМЕННО, до одобрения мини-аппа: адрес для кнопки «Мини-апп (тест)» в меню
# бота, https://… Пусто — кнопки нет.
MINIAPP_TEST_URL=https://magistralbot.0x33gr1n0.ru/

# ── общее ────────────────────────────────────────────────────
LOG_LEVEL=info
