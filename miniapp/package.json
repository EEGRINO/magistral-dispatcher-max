{
  "name": "max-dispatcher-miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "Рабочее место диспетчера — мини-приложение MAX (React + MAX UI)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:single": "tsc -p tsconfig.json --noEmit && vite build --mode single",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@maxhub/max-ui": "^0.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
